{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-bridge.cmd\"",
            "async": true,
            "timeoutMs": 30000,
            "statusMessage": "Starting WorkBuddy model bridge"
          }
        ]
      }
    ]
  }
}
